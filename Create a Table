<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML Tables</title>
    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
        }

        td {
            text-align: center;
             width: 100px;
        }

        ul {
            list-style-type: none;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>SNo</th>
            <th>Item Name</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Price</th>
        </tr>
        <tr>
            <td>1</td>
            <td>Item 1</td>
            <td>2</td>
            <td>50</td>
            <td>100</td>
        </tr>
         <tr>
            <td>2</td>
            <td>Item 2</td>
            <td>1</td>
            <td>10</td>
            <td>10</td>
        </tr>
        <tr>
            <td colspan="4">Total Price</td>
            <td>110</td>
        </tr>
    </table>
    <br><br>


     <table>
        <tr>
            <td rowspan="2">1</td>
            <td>3</td>
            <td>5</td>
            <td>7</td>
        </tr>
        <tr>
            <td >2</td>
            <td>4</td>
            <td>6</td>
            <td>8</td>
        </tr>
    </table>
    <br><br>


   


    <table>
        <tr>
            <td rowspan="4">
                <ul>
                    <li><a href="#">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li>Services</li>
                    <li>Contact</li>
                </ul>
            </td>
        </tr>

            <tr>
                <td>Header</td>
            </tr>

            <tr>
                <td rowspan="2">Main</td>
            </tr>
            <tr>
                <td rowspan="2">aside</td>
            </tr>
            <tr>
                <td rowspan="4"> Footer</td>
            </tr>
        
    </table>
</body>
</html>

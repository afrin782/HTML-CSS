<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration Form</title>
    <style>
        form {
            background-color: blueviolet;
            padding: 5%;
            margin: 1%;
        }

        input {
            background-color: antiquewhite;
        }
    </style>
</head>
<body>
    <h2><u>Student Form</u></h2>
    <form action="studentwel.html">
        <label for="studname">Student Name</label><br>
        <input id="studname" type="text" placeholder="Enter Student Name" tabindex="1" required>
        <br><br>
        <label for="pwd">Password</label><br>
        <input id="pwd" type="password" placeholder="Enter password" minlength="3"  tabindex="2" required>
        <br><br>
        <label for="email">Email</label><br>
        <input id="email" type="email" placeholder="Enter Email" required> 
        <br><br>
        <label>Gender</label><br>
        <input type="radio" name="Gender" required>
        <label>Male</label>
        <input type="radio" name="Gender">
        <label>Female</label>
        <br><br>
        <label for="age">Age</label><br>
        <input id="age" type="number" min="4" max="17">
        <br><br>
        <label for="phone">Mobile</label><br>
        <input id="phone" type="tel" pattern="[0-9]{10}" maxlength="10" required>
        <br><br>
        <input type="submit"><br><br>
       
    </form>
    
</body>
</html>
